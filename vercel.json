{
  "headers": [
    {
      "source": "/data/glof-study/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "functions": {
    "api/landslide.py": {
      "includeFiles": "server_data/landslide_*",
      "maxDuration": 30,
      "excludeFiles": "{src/**,dist/**,docs/**,machine learning/**,deployment/**,scripts/**,.github/**,api/tests/**,node_modules/**,**/__pycache__/**,public/**,server_data/glof/**,server_data/osm/**}"
    },
    "api/exposure.py": {
      "maxDuration": 25,
      "includeFiles": "server_data/osm/**",
      "excludeFiles": "{src/**,dist/**,docs/**,machine learning/**,deployment/**,scripts/**,.github/**,api/tests/**,node_modules/**,**/__pycache__/**,public/**,server_data/landslide_*,server_data/glof/**}"
    },
    "api/chat.py": {
      "maxDuration": 10,
      "excludeFiles": "{src/**,dist/**,docs/**,machine learning/**,deployment/**,scripts/**,.github/**,api/tests/**,node_modules/**,**/__pycache__/**,public/**,server_data/**}"
    },
    "api/glof.py": {
      "includeFiles": "server_data/glof/**",
      "maxDuration": 10,
      "excludeFiles": "{src/**,dist/**,docs/**,machine learning/**,deployment/**,scripts/**,.github/**,api/tests/**,node_modules/**,**/__pycache__/**,public/**,server_data/landslide_*,server_data/osm/**,server_data/glof/model/**}"
    },
    "api/catalog.py": {
      "maxDuration": 20,
      "excludeFiles": "{src/**,dist/**,docs/**,machine learning/**,deployment/**,scripts/**,.github/**,api/tests/**,node_modules/**,**/__pycache__/**,public/**,server_data/**}"
    },
    "api/events.py": {
      "maxDuration": 20,
      "includeFiles": "public/data/landslides-eonet-archive.json",
      "excludeFiles": "{src/**,dist/**,node_modules/**,machine*/**,server_data/{landslide_*,osm/**,glof/model/**},public/{brand/**,data/{glof*/**,nisar*/**,*.{webp,geojson,f32,u8},world*.json}}}"
    },
    "api/forecast.py": {
      "maxDuration": 20,
      "excludeFiles": "{src/**,dist/**,docs/**,machine learning/**,deployment/**,scripts/**,.github/**,api/tests/**,node_modules/**,**/__pycache__/**,public/**,server_data/**}"
    }
  }
}
