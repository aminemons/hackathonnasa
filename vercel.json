{
  "headers": [
    {"source": "/data/glof-study/(.*)", "headers": [
      {"key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400"}
    ]}
  ],
  "functions": {
    "api/landslide.py": {
      "includeFiles": "server_data/landslide_*",
      "maxDuration": 30
    },
    "api/exposure.py": {
      "maxDuration": 25
    },
    "api/chat.py": {
      "maxDuration": 10
    },
    "api/glof.py": {
      "includeFiles": "server_data/glof/**",
      "maxDuration": 10
    },
    "api/events.py": {
      "maxDuration": 20
    }
  }
}
